SUPPORTLENS_QDRANT_URL=http://localhost:6333
SUPPORTLENS_QDRANT_COLLECTION=supportlens_chunks
SUPPORTLENS_CORPUS_DIR=data/snapshot
SUPPORTLENS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Downloads an additional local multilingual cross-encoder model.
SUPPORTLENS_ENABLE_RERANKER=false
SUPPORTLENS_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Set only when you want LLM-generated answer text.
SUPPORTLENS_OPENAI_API_KEY=
SUPPORTLENS_OPENAI_MODEL=gpt-4.1-mini
SUPPORTLENS_MAX_QUESTION_CHARS=1000
SUPPORTLENS_EVIDENCE_SCORE_THRESHOLD=0.35
